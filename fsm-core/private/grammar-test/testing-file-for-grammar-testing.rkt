;; L =  U ba*

;; syntactic categories
;; S: words in EMP U ba*
;; A : words in a*
(define EMP-U-ba* (make-rg '(S A)
                           '(a b)
                           `((S -> ,EMP)
                            (S -> b)
                            (S -> bA)
                            (A -> a)
                            (A -> aA))
                           'S))
;; Tests for EMP-U-ba*
#;(check-equal? (grammar-derive EMP-U-ba* '(a))
              "(a) is not in L(G).")
#;(check-equal? (grammar-derive EMP-U-ba* '(a b b a a))
              "(a b b a a) is not in L(G).")
#;(check-equal? (grammar-derive EMP-U-ba* '())
              '(S -> ε))
#;(check-equal? (grammar-derive EMP-U-ba* '(b a))
              '(S -> bA -> ba))
#;(check-equal? (grammar-derive EMP-U-ba* '(b a a a))
              '(S -> bA -> baA -> baaA -> baaa))


;; word -> boolean
;;purpose: to determine if a would ought to be generated by S
(define (S-INV-EMP-U-ba* w)
  (or (empty? w)
      (and (eq? (first w) 'b)
           (andmap (λ (x) (eq? x 'a)) (rest w)))))

;(check-inv-holds? S-INV-EMP-U-ba* '() '(b) '(b a a) '(b a a a a a a a))
;(check-inv-fails? S-INV-EMP-U-ba* '(a) '(a b a a a b))


;; word -> boolean
;;purpose: to determine if a would ought to be generated by A
(define (A-INV-EMP-U-ba* w)
  (andmap (λ (x) (eq? x 'a)) w))

;(check-inv-holds? A-INV-EMP-U-ba* '() '(a) '(a a) '(a a a a a a a))
;(check-inv-fails? A-INV-EMP-U-ba* '(b a) '(a b a a a b))


(define loi-EMP-U-ba* (list (list 'S S-INV-EMP-U-ba*)
                            (list 'A A-INV-EMP-U-ba*)))

;; L = {w | the number of as in w is a multiple of 3}

;; Syntactic categories
;; S = words with 3n as
;; B = words with 3n + 2 as
;; C = words with 3n + 1 as

(define MULT3-as (make-rg '(S B C)
                          '(a b)
                          `((S -> ,EMP)
                            (S -> aB)
                            (S -> bS)
                            (B -> aC)
                            (B -> bB)
                            (C -> aS)
                            (C -> bC))
                          'S))

;; Tests for MULT3-as
;(check-equal? (grammar-derive MULT3-as '(b b a b b))
;              "(b b a b b) is not in L(G).")
;(check-equal? (grammar-derive MULT3-as '(b b a b b a))
;              "(b b a b b a) is not in L(G).")
;(check-equal? (grammar-derive MULT3-as '(b b a b a b a a b))
;              "(b b a b a b a a b) is not in L(G).")
;(check-equal? (grammar-derive MULT3-as '())
;              `(S -> ,EMP))
;(check-equal? (grammar-derive MULT3-as '(a a a))
;              `(S -> aB -> aaC -> aaaS -> aaa))
;(check-equal? (grammar-derive MULT3-as '(b b a a b a b b))
;              `(S -> bS -> bbS -> bbaB -> bbaaC -> bbaabC ->
;                bbaabaS -> bbaababS -> bbaababbS ->  bbaababb))


;; word -> boolean
;;purpose: to determine if a would ought to be generated by S
(define (S-INV-MULT3-as w)
  (let [(As (filter (λ (x) (eq? 'a x)) w))]
        (= 0 (remainder (length As) 3))))

;(check-inv-holds? S-INV-MULT3-as '() '(b) '(b a a a) '(b a a a a a a b))
;(check-inv-fails? S-INV-MULT3-as '(a) '(a b a a a b))


;; word -> boolean
;;purpose: to determine if a would ought to be generated by B
(define (B-INV-MULT3-as w)
  (let [(As (filter (λ (x) (eq? 'a x)) w))]
        (= 2 (remainder (length As) 3))))

;(check-inv-holds? B-INV-MULT3-as '(a a) '(b a a) '(b a a a a a b))
;(check-inv-fails? B-INV-MULT3-as '(a) '(a b a a a b))

;; word -> boolean
;;purpose: to determine if a would ought to be generated by C
(define (C-INV-MULT3-as w)
  (let [(As (filter (λ (x) (eq? 'a x)) w))]
        (= 1 (remainder (length As) 3))))

;(check-inv-holds? C-INV-MULT3-as '(a) '(b a) '(b a a a a b))
;(check-inv-fails? C-INV-MULT3-as '(a a) '(a b a a a a a b))


(define loi-MULT3-as (list (list 'S S-INV-MULT3-as)
                           (list 'B B-INV-MULT3-as)
                           (list 'C C-INV-MULT3-as)))

