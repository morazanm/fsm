;; L = w contains an even number of bs

;; syntactic categories
;; S: even number of bs
;; F: odd number of bs

(define EVEN-NUM-Bs-grammar
  (make-rg '(S F)
           '(a b)
           `((S -> ,EMP)
             (S -> aS)
             (S -> bF)
             (S -> a)
             (F -> aF)
             (F -> bS))
           'S))


;(check-derive? EVEN-NUM-Bs-grammar '() '(a) '(b b) '(b b b b))

;(check-not-derive? EVEN-NUM-Bs-grammar '(a b a) '(a b a a) '(b b a b a) '(a b b b a b b))


;; word -> boolean
;;purpose: to determine if a would ought to be generated by S
(define (S-INV-EVEN-NUM-Bs-grammar w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))]
        (even? (length Bs))))

;; word -> boolean
;;purpose: to determine if a would ought to be generated by F
(define (F-INV-EVEN-NUM-Bs-grammar w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))]
        (odd? (length Bs))))

(define loi-EVEN-NUM-Bs-grammar (list (list 'S S-INV-EVEN-NUM-Bs-grammar)
                                      (list 'F F-INV-EVEN-NUM-Bs-grammar)))

;; L = {w | w has an even number of and an odd number of b}

;; syntactic categories:
;; S: even number of a and odd number of b, start state
;; M: odd number of a and even number of b
;; N: even number of a and even number of b, final state
;; P: odd number of a and odd number of b
(define EVEN-A-ODD-B-grammar (make-rg '(S M N P)
                                      '(a b)
                                      `((S -> aP)
                                        (S -> bN)
                                        (M -> aN)
                                        (M -> bP)
                                        (N -> aM)
                                        (N -> bS)
                                        (P -> aS)
                                        (P -> bM)
                                        (S -> b)
                                        (M -> a))
                                      'S))

;(check-derive? EVEN-A-ODD-B-grammar '() '(a a b) '(b b) '(b b b b))
;(check-not-derive? EVEN-A-ODD-B-grammar '(a b a a) '(a b a a) '(b b a b b a) '(a b b a b a b b))


(define (S-INV-EVEN-A-ODD-B-grammar a-word)
  (and (even? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (odd? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define (M-INV-EVEN-A-ODD-B-grammar a-word)
  (and (odd? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (even? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define (N-INV-EVEN-A-ODD-B-grammar a-word)
  (and (even? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (even? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define (P-INV-EVEN-A-ODD-B-grammar a-word)
  (and (odd? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (odd? (length (filter (λ (w) (equal? w 'b)) a-word)))))


(define loi-EVEN-A-ODD-B-grammar (list (list 'S P-INV-EVEN-A-ODD-B-grammar)
                                       (list 'M M-INV-EVEN-A-ODD-B-grammar)
                                       (list 'N N-INV-EVEN-A-ODD-B-grammar)
                                       (list 'P P-INV-EVEN-A-ODD-B-grammar)))

;; L = (a)+(b)+(c)+ d
;; syntactic categories
;; S: w = (a)+(b)+(c)+ d
;; A: w = (b)+(c)+ d
;; B: w= (c)+ d
;; C: w= d
(define a+b+c+d (make-rg '(S A B C)
                         '(a b c d)
                         `((S -> aA)
                           (S -> aS)
                           (A -> bB)
                           (A -> bA)
                           (B -> cC)
                           (B -> cB)
                           (C -> d))
                         'S))


;(check-derive? a+b+c+d '(a a b c c d) '(a a b b b c c c d) '(a b c d) '(a a a a a a b b b b c c c c c d))
;(check-not-derive? a+b+c+d '(a) '(b) '(c) '(d) '(a a b b d))


;; invariants for a+b+c+d

;; S: w = (a)+(b)+(c)+ d
(define (S-INV-a+b+c+d ci)
  (if (empty? ci)
      #f
      (let*[(as (takef ci (λ (x) (eq? x 'a))))
            (bs (takef (drop ci (length as)) (λ (x) (eq? x 'b))))
            (cs (takef (drop ci (+ (length bs) (length as))) (λ (x) (eq? x 'c))))
            (d (first (drop ci (+ (length cs) (length bs) (length as)))))]
        (equal? ci (append as bs cs (list d))))))

;; A: w = (b)+(c)+ d
(define (A-INV-a+b+c+d ci)
  (let*[(bs (takef ci (λ (x) (eq? x 'b))))
        (cs (takef (drop ci (length bs)) (λ (x) (eq? x 'c))))
        (d (first (drop ci (+ (length cs) (length bs)))))]
    (equal? ci (append bs cs (list d)))))


;; B: w= (c)+ d
(define (B-INV-a+b+c+d ci)
  (let*[(cs (takef ci (λ (x) (eq? x 'c))))
        (d (first (drop ci (length cs))))]
    (equal? ci (append cs (list d)))))


;; C: w= d
(define (C-INV-a+b+c+d ci)
    (equal? ci '(d)))


(define loi-a+b+c+d (list (list 'S S-INV-a+b+c+d)
                          (list 'A A-INV-a+b+c+d)
                          (list 'B B-INV-a+b+c+d)
                          (list 'C C-INV-a+b+c+d)))




;; syntactic categories:
;; S: word contains abba
;; A: word starts with abb
;; B: word starts with ab
;; C: word starts with a
;; D: (a U b)+
(define CONTAINS-ABBA (make-rg  '(S A B C D)
                                '(a b)
                                `( (S ,ARROW aA) (S ,ARROW bS)
                                   (A ,ARROW aA) (A ,ARROW bB)
                                   (B ,ARROW aA) (B ,ARROW bC)
                                   (C ,ARROW aD) (C ,ARROW bS)
                                   (D ,ARROW aD) (D ,ARROW bD)
                                   (D ,ARROW a)  (D ,ARROW b))
                                'S
                                #:rejects (list '(b) '(a) '(a a) '(a b b) '(a b b b))
                                #:accepts (list '(a b b a a) '(a a b b a a))))


(define (S-INV-CONTAINS-ABBA w)
  (contains? w '(a b b a)))

(define (A-INV-CONTAINS-ABBA w)
  (or (contains? w '(a b b a))
      (and (<= 3 (length w))
           (equal? '(b b a) (take w 3)))))

(define (B-INV-CONTAINS-ABBA w)
  (or (contains? w '(a b b a))
      (and (<= 2 (length w))
           (equal? '(b a) (take w 2)))))

(define (C-INV-CONTAINS-ABBA w)
  (or (contains? w '(a b b a))
      (and (<= 1 (length w))
           (equal? '(a) (take w 1)))))

(define (D-INV-CONTAINS-ABBA w)
  (<= 1 (length w)))


(define loi-CONTAINS-ABBA (list (list 'S S-INV-CONTAINS-ABBA)
                                (list 'A A-INV-CONTAINS-ABBA)
                                (list 'B B-INV-CONTAINS-ABBA)
                                (list 'C C-INV-CONTAINS-ABBA)
                                (list 'D D-INV-CONTAINS-ABBA)))


;; S = word contains even b and odd a
;; A = word contains even b and even a
;; B = word contains odd b and odd a, final terminal
;; C = word contains odd b and even a
(define EVEN-B-ODD-A
  (make-rg '(S A B C)
           '(a b)
           `((S ,ARROW aA)
             (S ,ARROW bB)
             (S ,ARROW a)

             (A ,ARROW aS)
             (A ,ARROW bC)

             (B ,ARROW aC)
             (B ,ARROW bS)

             (C ,ARROW aB)
             (C ,ARROW bA)
             (C ,ARROW b))
           'S))



(define (S-INV-EVEN-B-ODD-A a-word)
  (and (odd? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (even? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define (A-INV-EVEN-B-ODD-A a-word)
  (and (even? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (even? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define (B-INV-EVEN-B-ODD-A a-word)
  (and (odd? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (odd? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define (C-INV-EVEN-B-ODD-A a-word)
  (and (even? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (odd? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define loi-EVEN-B-ODD-A (list (list 'S S-INV-EVEN-B-ODD-A)
                               (list 'A A-INV-EVEN-B-ODD-A)
                               (list 'B B-INV-EVEN-B-ODD-A)
                               (list 'C C-INV-EVEN-B-ODD-A)))

;; syntactic categories
;;  S = words that start with aa, starting nonterminal
;;  A = words that start with a
;;  B = words that start with either a or b
(define rg-STARTS-WITH-aa (make-rg '(S A B) 
                                   '(a b) 
                                   '((S -> aA)
                                     (A -> a)
                                     (A -> aB)
                                     (B -> a)
                                     (B -> aB)
                                     (B -> b)
                                     (B -> bB))
                                   'S))

;; invariants

;; word -> boolean
;;purpose: to determine if a would ought to be generated by S
(define (S-INV-rg-STARTS-WITH-aa w)
  (<= 2 (length (takef w (λ (x) (eq? 'a x))))))

;(check-inv-holds? S-INV-rg-STARTS-WITH-aa '(a a) '(a a a b) '(a a a b b))
;(check-inv-fails? S-INV-rg-STARTS-WITH-aa '() '(b) '(b b a) '(b a a b a))

;; word -> boolean
;;purpose: to determine if a would ought to be generated by A
(define (A-INV-rg-STARTS-WITH-aa w)
  (<= 1 (length (takef w (λ (x) (eq? 'a x))))))

;; word -> boolean
;;purpose: to determine if a would ought to be generated by B
(define (B-INV-rg-STARTS-WITH-aa w)
  (and (<= 1 (length w))
       (equal? w (takef w (λ (x) (or (eq? 'b x)
                                     (eq? 'a x)))))))

;(check-inv-holds? B-INV-rg-STARTS-WITH-aa '(a) '(b) '(b a a) '(a b a b))
;(check-inv-fails? B-INV-rg-STARTS-WITH-aa '())

(define loi-rg-STARTS-WITH-aa (list (list 'S S-INV-rg-STARTS-WITH-aa)
                                    (list 'A A-INV-rg-STARTS-WITH-aa)
                                    (list 'B B-INV-rg-STARTS-WITH-aa)
                                    ))

;; syntactic categories:
;; S: (bba)*
;; A: ba(bba)*
;; B: a(bba)*

(define bba-* (make-rg '(S A B) 
                       '(a b) 
                       `((S -> bA)
                         (S -> ,EMP)
                         (A -> bB)
                         (B -> aS))
                       'S))
;; invariants

;; word -> boolean
;; purpose: to determine if w ought to be generated by S
;; S = (bba)*
(define (S-INV-bba-* w)
  (cond
    [(empty? w) #t]
    [(and (>= (length w) 3)
          (eq? 'b (first w))
          (eq? 'b (second w))
          (eq? 'a (third w)))
     (S-INV-bba-* (drop w 3))]
    [else #f]))


;; word -> boolean
;; purpose: to determine if w ought to be generated by A
;; A = ba(bba)*
(define (A-INV-bba-* w)
  (and (>= (length w) 2)
       (eq? 'b (first w))
       (eq? 'a (second w))
       (S-INV-bba-* (drop w 2))))


;; word -> boolean
;; purpose: to determine if w ought to be generated by B
;; B = a(bba)*
(define (B-INV-bba-* w)
  (and (>= (length w) 1)
       (eq? 'a (first w))
       (S-INV-bba-* (rest w))))


(define loi-bba-* (list (list 'S S-INV-bba-*)
                                    (list 'A A-INV-bba-*)
                                    (list 'B B-INV-bba-*)))


