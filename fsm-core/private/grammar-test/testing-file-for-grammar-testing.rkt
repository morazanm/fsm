;; L = w contains an even number of bs

;; syntactic categories
;; S: even number of bs
;; F: odd number of bs

(define EVEN-NUM-Bs-grammar
  (make-rg '(S F)
           '(a b)
           `((S -> ,EMP)
             (S -> aS)
             (S -> bF)
             (S -> a)
             (F -> aF)
             (F -> bS))
           'S))


;(check-derive? EVEN-NUM-Bs-grammar '() '(a) '(b b) '(b b b b))

;(check-not-derive? EVEN-NUM-Bs-grammar '(a b a) '(a b a a) '(b b a b a) '(a b b b a b b))


;; word -> boolean
;;purpose: to determine if a would ought to be generated by S
(define (S-INV-EVEN-NUM-Bs-grammar w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))]
        (even? (length Bs))))

;; word -> boolean
;;purpose: to determine if a would ought to be generated by F
(define (F-INV-EVEN-NUM-Bs-grammar w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))]
        (odd? (length Bs))))


;; L = {w | w has an even number of and an odd number of b}

;; syntactic categories:
;; S: even number of a and even number of b, start state
;; M: odd number of a and odd number of b
;; N: even number of a and odd number of b, final state
;; P: odd number of a and even number of b

;; syntactic categories
;; S: even num as AND odd num bs
;; M: 

(define EVEN-A-ODD-B-grammar (make-rg '(S M N P)
                                      '(a b)
                                      `((S -> aP)
                                        (S -> ,EMP)
                                        (S -> bN)
                                        (S -> b)
                                        (M -> aN)
                                        (M -> a)
                                        (M -> bP)
                                        (N -> aM)
                                        (N -> bS)
                                        (P -> aS)
                                        (P -> bM))
                                      'S))

;(check-derive? EVEN-A-ODD-B-grammar '() '(a a b) '(b b) '(b b b b))
;(check-not-derive? EVEN-A-ODD-B-grammar '(a b a a) '(a b a a) '(b b a b b a) '(a b b a b a b b))


(define (S-INV-EVEN-A-ODD-B-grammar a-word)
  (and (odd? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (even? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define (M-INV-EVEN-A-ODD-B-grammar a-word)
  (and (odd? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (odd? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define (N-INV-EVEN-A-ODD-B-grammar a-word)
  (and (even? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (odd? (length (filter (λ (w) (equal? w 'b)) a-word)))))

(define (P-INV-EVEN-A-ODD-B-grammar a-word)
  (and (odd? (length (filter (λ (w) (equal? w 'a)) a-word)))
       (even? (length (filter (λ (w) (equal? w 'b)) a-word)))))


(rg-test-invs-andres EVEN-A-ODD-B-grammar  (list (list 'S S-INV-EVEN-A-ODD-B-grammar)
                                                (list 'M M-INV-EVEN-A-ODD-B-grammar)
                                                (list 'N N-INV-EVEN-A-ODD-B-grammar)
                                                (list 'P P-INV-EVEN-A-ODD-B-grammar)))


