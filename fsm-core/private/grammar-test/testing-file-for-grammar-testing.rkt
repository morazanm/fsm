;              "(b b a b a b a a b) is not in L(G).")
;(check-equal? (grammar-derive MULT3-as '())
;              `(S -> ,EMP))
;(check-equal? (grammar-derive MULT3-as '(a a a))
;              `(S -> aB -> aaC -> aaaS -> aaa))
;(check-equal? (grammar-derive MULT3-as '(b b a a b a b b))
;              `(S -> bS -> bbS -> bbaB -> bbaaC -> bbaabC ->
;                bbaabaS -> bbaababS -> bbaababbS ->  bbaababb))


;; word -> boolean
;;purpose: to determine if a would ought to be generated by S
(define (S-INV-MULT3-as w)
  (let [(As (filter (λ (x) (eq? 'a x)) w))]
        (= 0 (remainder (length As) 3))))

;(check-inv-holds? S-INV-MULT3-as '() '(b) '(b a a a) '(b a a a a a a b))
;(check-inv-fails? S-INV-MULT3-as '(a) '(a b a a a b))


;; word -> boolean
;;purpose: to determine if a would ought to be generated by B
(define (B-INV-MULT3-as w)
  (let [(As (filter (λ (x) (eq? 'a x)) w))]
        (= 2 (remainder (length As) 3))))

;(check-inv-holds? B-INV-MULT3-as '(a a) '(b a a) '(b a a a a a b))
;(check-inv-fails? B-INV-MULT3-as '(a) '(a b a a a b))

;; word -> boolean
;;purpose: to determine if a would ought to be generated by C
(define (C-INV-MULT3-as w)
  (let [(As (filter (λ (x) (eq? 'a x)) w))]
        (= 1 (remainder (length As) 3))))

;(check-inv-holds? C-INV-MULT3-as '(a) '(b a) '(b a a a a b))
;(check-inv-fails? C-INV-MULT3-as '(a a) '(a b a a a a a b))


;; L = w does not contain aa

;; syntatic categories
;; S = words that do no contain aa
;; A = words that start with b and don't contain aa
;; B = words that start with b or a, and don't contain aa
(define NO-AA-grammer (make-rg '(S A B)
                               '(a b)
                               `((S -> ,EMP)
                                 (S -> aA)
                                 (S -> a)
                                 (S -> bB)
                                 (S -> b)
                                 (A -> bB)
                                 (A -> b)
                                 (B -> aA)
                                 (B -> a)
                                 (B -> b)
                                 (B -> bB))
                               'S))
                               



;(check-derive? NO-AA-grammer '() '(a) '(b) '(b b))

;(check-not-derive? NO-AA-grammer '(a a) '(a a a) '(b b a a) '(a a b b))



(define (S-INV-NO-AA-grammer ci)  
  (not (contains? ci '(a a))))


(define (A-INV-NO-AA-grammer ci)
  #;(and (equal? (drop ci (- (length ci) 1)) '(a))    
       (not (contains? ci '(a a))))
  (and (eq? (first ci) 'b)
       (not (contains? ci '(a a)))))

(define (B-INV-NO-AA-grammer ci)
  (and (not (contains? ci '(a a)))
       (or (eq? (first ci) 'b)
           (eq? (first ci) 'a))))


