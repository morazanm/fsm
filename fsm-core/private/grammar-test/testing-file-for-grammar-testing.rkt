;; Syntactic categories:
;; S: number of bs is greater than the amount of as
;; A: number of bs is greater than or equal to the number of as
(define numb>numa
  (make-cfg '(S A)
            '(a b)
            `((S ,ARROW b)
              (S ,ARROW AbA)
              (A ,ARROW AaAbA)
              (A ,ARROW AbAaA)
              (A ,ARROW ,EMP)
              (A ,ARROW bA))
            'S))

(define (S-INV-numb>numa w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))
        (As (filter (λ (x) (eq? 'a x)) w))]
    (> (length Bs) (length As))))


(define (A-INV-numb>numa w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))
        (As (filter (λ (x) (eq? 'a x)) w))]
    (>= (length Bs) (length As))))

(define loi-numb>numa (list (list 'S S-INV-numb>numa)
                            (list 'A A-INV-numb>numa)))


;; syntactic categories
;; S: word is a palindrome
(define palindrome
  (make-cfg '(S)
            '(a b)
            `((S ,ARROW ,EMP)
              (S ,ARROW aSa)
              (S ,ARROW bSb)
              (S ,ARROW a)
              (S ,ARROW b))
            'S))

(define (S-INV-palindrome w)
  (equal? w (reverse w)))

(define loi-palindrome (list (list 'S S-INV-palindrome)))


;; Syntactic categories
;; S: word is c^mb^na^nd^m
;; A: word is b^na^n
(define c^mb^na^nd^m
  (make-cfg '(S A)
            '(a b c d)
            `((S -> cSd)
              ;(S -> cAd)
              (S -> A)
              (A -> ,EMP)
              (A -> bAa))
            'S))

;;unit tests 
;(check-derive? c^mb^na^nd^m '() '(c d) '(b a) '(c b a d) '(c c b a d d))
;(check-not-derive? c^mb^na^nd^m '(c) '(a) '(b) '(d) '(c d d) '(a d) '(c b b a d))

;; invariants

;; word -> boolean
;; purpose: to determine if given word ought to be generated by S
(define (S-INV-c^mb^na^nd^m w)
  (let* ([Cs (takef w (λ (x) (eq? 'c x)))]
         [Bs (takef (drop w (length Cs)) (λ (x) (eq? 'b x)))]
         [As (takef (drop w (+ (length Bs) (length Cs))) (λ (x) (eq? 'a x)))]
         [Ds (takef (drop w (+ (length As) (length Bs) (length Cs))) (λ (x) (eq? 'd x)))])
    (and (append Cs Bs As Ds)
         (= (length Cs) (length Ds))
         (= (length Bs) (length As)))))
  

;; word -> boolean
;; purpose: to determine if given word ought to be generated by A
(define (A-INV-c^mb^na^nd^m w)
  (let* ([Bs (takef w (λ (x) (eq? 'b x)))]
         [As (takef (drop w (length Bs)) (λ (x) (eq? 'a x)))])
    (and (append Bs As)
         (= (length Bs) (length As)))))
  
(define loi-c^mb^na^nd^m (list (list 'S S-INV-c^mb^na^nd^m)
                               (list 'A A-INV-c^mb^na^nd^m)))


;; syntactic categories
;; S: word is wcw^r
(define wcw^r
  (make-cfg '(S)
            '(a b c)
            `((S ,ARROW c)
              (S ,ARROW aSa)
              (S ,ARROW bSb)
              (S ,ARROW a)
              (S ,ARROW b))
            'S))

(define (S-INV-wcw^r w)
  (equal? w (reverse w)))

(define loi-wcw^r (list (list 'S S-INV-wcw^r)))


;; syntactic categories:
;; S: word is aibj, where i <= j
;; A: word has equal num as and bs
;; B: word is b*
(define aibj
  (make-cfg '(S A B)
            '(a b)
            `((S -> AB)
              (A -> aAb)
              (A -> ,EMP)
              (B -> bB)
              (B -> ,EMP))
            'S))



(define (S-INV-aibj w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))
        (As (filter (λ (x) (eq? 'a x)) w))]
    (and (equal? w (append As Bs))
         (>= (length Bs) (length As)))))

(define (A-INV-aibj w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))
        (As (filter (λ (x) (eq? 'a x)) w))]
    (and (equal? w (append As Bs))
         (= (length Bs) (length As)))))

(define (B-INV-aibj w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))]
    (equal? w Bs)))

(define loi-aibj (list (list 'S S-INV-aibj)
                       (list 'A A-INV-aibj)
                       (list 'B B-INV-aibj)))
                       


;syntactic categories:
;; S: word is aibj, where  i <= 2j
(define aibj2
  (make-cfg '(S A)
            '(a b)
            `((S -> ,EMP)
              (S -> aSb)
              (S -> aSbb))
            'S))

(define (S-INV-aibj2 w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))
        (As (filter (λ (x) (eq? 'a x)) w))]
    (and (equal? w (append As Bs))
         (>= (* 2 (length Bs)) (length As)))))

(define loi-aibj2 (list (list 'S S-INV-aibj2)))



;;syntactic categories:
;; S: word is a^nb^n
(define anbn
  (make-cfg '(S)
            '(a b)
            `((S -> ,EMP)
              (S -> aSb))
            'S))

(define (S-INV-anbn w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))
        (As (filter (λ (x) (eq? 'a x)) w))]
    (and (equal? w (append As Bs))
         (= (length Bs) (length As)))))

(define loi-anbn (list (list 'S S-INV-anbn)))


;;syntactic categories:
;; S: word is a^nb^ma^n
;; A: word is b*
(define anbman
  (make-cfg '(S A)
            '(a b)
            `((S -> ,EMP)
              (S -> aSa)
              (S -> aAa)
              (S -> A)
              (A -> b)
              (A -> bA))
            'S))

(define (S-INV-anbman w)
  (or (empty? w)
  (let* [(As1 (takef w (λ (x) (eq? 'a x))))
         (Bs (takef (drop w (length As1)) (λ (x) (eq? 'b x))))
         (As2 (takef (drop w (+ (length Bs) (length As1))) (λ (x) (eq? 'a x))))]
    (and (equal? w (append As1 Bs As2))
         (if (empty? Bs)
             (equal? w As1)
             (= (length As1) (length As2)))))))

(define (A-INV-anbman w)
  (let* [(Bs (filter (λ (x) (eq? 'b x)) w))]
    (and (equal? w Bs))))

(define loi-anbman (list (list 'S S-INV-anbman)
                         (list 'A A-INV-anbman)))


;;syntactic categories:
;; S: word is (a^nb^n)*
;; A: word is a^nb^n 
(define anbn-*
  (make-cfg '(S A)
            '(a b)
            `((S -> ,EMP)
              (S -> AS)
              (A -> ,EMP)
              (A -> aAb))
            'S))

(define (S-INV-anbn-* ci)
  (let* ([As (takef ci (λ (x) (eq? 'a x)))]
         [Bs (takef (drop ci (length As)) (λ (x) (eq? 'b x)))])
  (if (and (empty? (drop ci (+ (length Bs) (length As)))))
      (= (length As) (length Bs))
      (and (= (length As) (length Bs))
           (S-INV-anbn-* (drop ci (+ (length As) (length Bs))))))))

(define (A-INV-anbn-* w)
  (let [(Bs (filter (λ (x) (eq? 'b x)) w))
        (As (filter (λ (x) (eq? 'a x)) w))]
    (and (equal? w (append As Bs))
         (= (length Bs) (length As)))))

(define loi-anbn-* (list (list 'S S-INV-anbn-*)
                         (list 'A A-INV-anbn-*)))



;; syntactic categories
;; S: word is a^nb^mc^jd^k, where n+m = j+k
;; A: 
(define a^nb^mc^jd^k
  (make-cfg '(S A B C)
            '(a b c d)
            `((S -> aSd)
              (S -> A)
              (S -> B)
              (A -> aAc)
              (A -> B)
              (B -> bBc)
              (B -> ,EMP)
              (C -> bCd)
              (C -> B))
            'S))


(define (S-INV-a^nb^mc^jd^k w)
  (or (empty? w)
  (let* [(As (takef w (λ (x) (eq? 'a x))))
         (Bs (takef (drop w (length As)) (λ (x) (eq? 'b x))))
         (Cs (takef (drop w (+ (length Bs) (length As))) (λ (x) (eq? 'c x))))
         (Ds (takef (drop w (+ (length Cs) (length Bs) (length As))) (λ (x) (eq? 'd x))))]
    (and (equal? w (append As Bs Cs Ds))
         (= (+ (length As) (length Bs)) (+ (length Cs) (length Ds)))))))

(define loi-a^nb^mc^jd^k (list (list 'S S-INV-a^nb^mc^jd^k)
                               (list 'A (λ (x) #t))
                               (list 'B (λ (x) #t))
                               (list 'C (λ (x) #t))))


