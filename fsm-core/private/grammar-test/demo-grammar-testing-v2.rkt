#lang fsm
;; L = w starts with aa
;; syntactic categories
;;  S = words that start with aa, starting nonterminal
;;  B = words that start with a
;;  A = words that start with either a or b
(define START-WITH-aa (make-rg '(S A B) 
                               '(a b) 
                               '((S -> aB)
                                 (B -> aA)
                                 (B -> a)
                                 (A -> a)
                                 (A -> aA)
                                 (A -> b)
                                 (A -> bA))
                               'S))

(check-derive? START-WITH-aa '(a a) '(a a b a) '(a a b b))
(check-not-derive? START-WITH-aa '() '(b) '(a))

;; word->Boolean
;; Purpose: Determine if w ought to be generated by S
(define (S-INV w)
  (<= 2 (length (takef w (λ (x) (eq? 'a x))))))

(check-inv-holds? S-INV '(a a) '(a a a b) '(a a a b b))
(check-inv-fails? S-INV '() '(b) '(a b a) '(b a a b a))

;; word->Boolean
;; Purpose: Determine if w ought to be generated by A
(define (A-INV w)
  (and (<= 1 (length w))
       (equal? w (takef w (λ (x) (or (eq? 'b x)
                                     (eq? 'a x)))))))

(check-inv-holds? A-INV '(a) '(b) '(b a a) '(a b a b))
(check-inv-fails? A-INV '())

;; word -> boolean
;;purpose: to determine if a would ought to be generated by A
(define (B-INV w)
  (<= 1 (length (takef w (λ (x) (eq? 'a x))))))

;(grammar-test-invs START-WITH-aa (list 'S S-INV) (list 'A A-INV) (list 'B B-INV))



