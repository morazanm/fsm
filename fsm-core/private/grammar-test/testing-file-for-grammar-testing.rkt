;; P: odd number of a and even number of b




;; L = (a)+(b)+(c)+ d
;; syntactic categories
;; S: w = (a)+(b)+(c)+ d
;; A: w = (b)+(c)+ d
;; B: w= (c)+ d
;; C: w= d
(define a+b+c+d (make-rg '(S A B C)
                         '(a b c d)
                         `((S -> aA)
                           (S -> aS)
                           (A -> bB)
                           (A -> bA)
                           (B -> cC)
                           (B -> cB)
                           (C -> d))
                         'S))


;(check-derive? a+b+c+d '(a a b c c d) '(a a b b b c c c d) '(a b c d) '(a a a a a a b b b b c c c c c d))
;(check-not-derive? a+b+c+d '(a) '(b) '(c) '(d) '(a a b b d))


;; invariants for a+b+c+d

;; S: w = (a)+(b)+(c)+ d
(define (S-INV-a+b+c+d ci)
  (if (empty? ci)
      #f
      (let*[(as (takef ci (λ (x) (eq? x 'a))))
            (bs (takef (drop ci (length as)) (λ (x) (eq? x 'b))))
            (cs (takef (drop ci (+ (length bs) (length as))) (λ (x) (eq? x 'c))))
            (d (first (drop ci (+ (length cs) (length bs) (length as)))))]
        (equal? ci (append as bs cs (list d))))))

;; A: w = (b)+(c)+ d
(define (A-INV-a+b+c+d ci)
  (let*[(bs (takef ci (λ (x) (eq? x 'b))))
        (cs (takef (drop ci (length bs)) (λ (x) (eq? x 'c))))
        (d (first (drop ci (+ (length cs) (length bs)))))]
    (equal? ci (append bs cs (list d)))))


;; B: w= (c)+ d
(define (B-INV-a+b+c+d ci)
  (let*[(cs (takef ci (λ (x) (eq? x 'c))))
        (d (first (drop ci (length cs))))]
    (equal? ci (append cs (list d)))))


;; C: w= d
(define (C-INV-a+b+c+d ci)
    (equal? ci '(d)))



(define CONTAINS-ABBA (make-rg  '(S A B C D)
                                '(a b)
                                `( (S ,ARROW aA) (S ,ARROW bS)
                                   (A ,ARROW aA) (A ,ARROW bB)
                                   (B ,ARROW aA) (B ,ARROW bC)
                                   (C ,ARROW aD) (C ,ARROW bS)
                                   (D ,ARROW aD) (D ,ARROW bD)
                                   (D ,ARROW a)  (D ,ARROW b))
                                'S
                                #:rejects (list '(b) '(a) '(a a) '(a b b) '(a b b b))
                                #:accepts (list '(a b b a a) '(a a b b a a))))



